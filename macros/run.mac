#  Geometry help:
#
#            | PMT|  
#            ------      ________ Upper Interface
#           /      \        
#          / Upper  \        
#         /  Guide   \      
#        /   Cone     \ 
#	     |	          |
#	     |   Middle   |
#	     |   Box      |
#	     |	          |  ________ Lower Interface
#        \            /
#         \  Lower   /		
#          \ Guide  /			
#           \Cone  /     ________ Quartz-LG interface plane
#            |    |
#            |    | Quartz
#            |    |
#    --->    |    |
#   Beam (Z) |_ __|
#
#               ^
#              / \  (y)
#               |
#  (x) into screen

#  The below parameters are for the front flush segment

#------------------#BF Segment commands --------------------#

#------------------#Ring 1 commands --------------------#

/Ring1/LightGuideLowerConeBackAngle 22 deg         #Angle between positive y-axis (length of quartz) and the downstream lower cone surface 
/Ring1/LightGuideLowerConeFrontAngle 18 deg        #Angle between positive y-axis (length of quartz) and the upstream lower cone surface
/Ring1/LightGuideLowerInterface 75 mm              #Distance between quartz-LG interface and lower interface plane
/Ring1/LightGuideMiddleBox 400 mm			       #Height of box between upper and lower cones	
/Ring1/LightGuideUpperInterface 251 mm             #Distance between upper and lower interface planes
/Ring1/LightGuideQuartzInterfaceOpeningX 17.7 cm   #These should be set according to the quartz size (always add 8 mm to quartz width ) (+0.8 disabled for Mainz beam test. Will return after)
/Ring1/LightGuideQuartzInterfaceOpeningZ 2.7 cm    #But larger, according to the CAD model  (it's 1.7 cm for 1 cm thick quartz and 2.2 cm for 1.5 cm thick quartz) (+0.7 disabled for Mainz test. Will return after)
/Ring1/LightGuideQuartzToPMTOffset -2 mm           #offset of PMT along Z w.r.t quartz to center light on cathode
/Ring1/LightGuidePMTInterfaceOpeningX 7.0 cm       #These should stay fixed - set by the PMT size 
/Ring1/LightGuidePMTInterfaceOpeningZ 7.0 cm       #

/Ring1/QuartzSizeZ 20 mm
/Ring1/QuartzSizeX 169 mm
/Ring1/QuartzSizeY 30 mm                           #Without the 45 degree cut
/Ring1/QuartzRotX -3 deg                           #rotate the quartz w.r.t. the light guide

/Ring1/SetCenterPositionInX 0 mm
/Ring1/SetCenterPositionInY 344.79 mm              #When placing modules, the change in position due to PolarRotation != 0 must be done by hand
/Ring1/SetCenterPositionInZ 1909.10 mm             #Annoying, but can be done. Use rotation matrix about X-axis
/Ring1/PolarRotation 6 deg                         #counter rotate the detector as a whole about the x-axis
/Ring1/AzimuthalRotation 0 deg                 #Rotates the detector about the z-axis

/Ring1/UpdateGeometry

