/Ring14/LightGuidePMTInterfaceOpeningX 7.0 cm       #These should stay fixed - set by the PMT size 
/Ring14/LightGuidePMTInterfaceOpeningZ 7.0 cm

/Ring14/QuartzSizeZ 17 mm
/Ring14/QuartzSizeX 80 mm
/Ring14/QuartzSizeY 140 mm                          #Without the 45 degree cut
/Ring14/QuartzRotX -3 deg                           #rotate the quartz w.r.t. the light guide

/Ring14/SetCenterPositionInX 163.3 mm                 #-86.7 when about the origin, 66.3 in the FF segment (shifted by +250 mm)
/Ring14/SetCenterPositionInY 427.7 mm
/Ring14/SetCenterPositionInZ 651.64 mm
/Ring14/PolarRotation 6 deg                         #counter rotate the detector as a whole about the x-axis
/Ring14/AzimuthalRotation 0 deg                  #Rotates the detector about the z-axis

/Ring14/UpdateGeometry

